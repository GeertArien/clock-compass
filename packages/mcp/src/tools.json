[
  {
    "name": "set_task_done",
    "description": "Mark a task done (done: true) or open (done: false).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id of an existing task."
        },
        "done": {
          "type": "boolean",
          "description": "true to complete, false to reopen."
        }
      },
      "required": [
        "taskId",
        "done"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "schedule_task",
    "description": "Put a task on a day in the Clock, at a time or at no particular time (time left out = no time), or take it off (day: null).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id of an existing task."
        },
        "day": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "YYYY-MM-DD, or null to unschedule."
        },
        "time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "HH:MM on that day; null or left out for no particular time."
        }
      },
      "required": [
        "taskId",
        "day"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "set_big_rock",
    "description": "Pin a Quadrant II task as a big rock (bigRock: true), or unpin it. A rock stays pinned until it is unpinned.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id of an existing Q2 task (important, not urgent)."
        },
        "bigRock": {
          "type": "boolean",
          "description": "true to pin, false to unpin."
        }
      },
      "required": [
        "taskId",
        "bigRock"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "set_habit_done",
    "description": "Check a habit off for a day (done: true), or undo that day's check-off (done: false). The day defaults to today; a future day is refused.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "habitId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id of an existing habit."
        },
        "done": {
          "type": "boolean",
          "description": "true to check off, false to undo."
        },
        "day": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "YYYY-MM-DD, today or earlier; left out = today."
        }
      },
      "required": [
        "habitId",
        "done"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "accept_week_plan",
    "description": "Make exactly these Quadrant II tasks the open big rocks for the week: they are pinned, and every other open rock is unpinned. Rocks already done stay pinned.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "weekStart": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Monday of the ISO week, YYYY-MM-DD."
        },
        "taskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "minItems": 1,
          "maxItems": 7,
          "description": "The big rocks, 1 to 7 distinct task ids (Q2 tasks)."
        }
      },
      "required": [
        "weekStart",
        "taskIds"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true
    }
  },
  {
    "name": "set_intention",
    "description": "Set this week's intention for one renewal dimension (Sharpen the Saw), replacing the current one, or clear it (text: null).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "PHYSICAL",
            "MENTAL",
            "SOCIAL_EMOTIONAL",
            "SPIRITUAL"
          ],
          "description": "PHYSICAL, MENTAL, SOCIAL_EMOTIONAL or SPIRITUAL."
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            {
              "type": "null"
            }
          ],
          "description": "The intention, one short sentence (at most 280 characters), or null to clear it."
        }
      },
      "required": [
        "dimension",
        "text"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true
    }
  },
  {
    "name": "create_task",
    "description": "Create a new task with these details (only the title is required). Confirming the same proposal again does not make a second task.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The task's title (at most 200 characters)."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Notes (at most 2000 characters)."
        },
        "important": {
          "type": "boolean",
          "description": "Important (Habit 3); left out = not important."
        },
        "urgent": {
          "type": "boolean",
          "description": "Urgent; left out = not urgent."
        },
        "proactivity": {
          "type": "string",
          "enum": [
            "INFLUENCE",
            "CONCERN"
          ],
          "description": "INFLUENCE (actionable) or CONCERN (not in your control); left out = neither."
        },
        "dueDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Due date, YYYY-MM-DD."
        },
        "scheduledDay": {
          "$ref": "#/properties/dueDate",
          "description": "Day to do it in the Clock, YYYY-MM-DD."
        },
        "scheduledTime": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "HH:MM on that day (needs scheduledDay)."
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id of an existing project."
        },
        "goalId": {
          "$ref": "#/properties/projectId",
          "description": "Id of an existing goal."
        },
        "repeat": {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "enum": [
                "DAY",
                "WEEK",
                "MONTH",
                "YEAR"
              ],
              "description": "DAY, WEEK, MONTH or YEAR."
            },
            "every": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999,
              "description": "Every this many units; left out = 1."
            },
            "from": {
              "type": "string",
              "enum": [
                "SCHEDULE",
                "COMPLETION"
              ],
              "description": "SCHEDULE (the default): fixed dates, e.g. every 1 November. COMPLETION: counted from the day it is done."
            },
            "leadDays": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 365
                },
                {
                  "type": "null"
                }
              ],
              "description": "Show it only this many days before it is due (e.g. 21 for a yearly task); left out or null = shown as soon as it is created."
            }
          },
          "required": [
            "unit"
          ],
          "additionalProperties": false,
          "description": "Repeat the task: when it is done, the next one is created. { unit: DAY|WEEK|MONTH|YEAR, every?: number (default 1), from?: SCHEDULE (fixed dates, the default) or COMPLETION (counted from the day it is done), leadDays?: show it only this many days before it is due, e.g. 21 for yearly }. Needs a due date or a scheduled day."
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[\\x21-\\x7e]{8,200}$",
          "description": "Optional, 8 to 200 visible ASCII characters. The same key creates the item once: sending it again (a retry after a lost answer) answers with the item made the first time (changed: 0)."
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false
    }
  },
  {
    "name": "update_task",
    "description": "Set the given fields of an existing task to these values (fields left out stay as they are; null clears a field).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Id of an existing task."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The task's title (at most 200 characters)."
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ],
          "description": "New notes, or null to clear them."
        },
        "important": {
          "type": "boolean",
          "description": "Important (true) or not (false)."
        },
        "urgent": {
          "type": "boolean",
          "description": "Urgent (true) or not (false)."
        },
        "proactivity": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "INFLUENCE",
                "CONCERN"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "INFLUENCE, CONCERN, or null for neither."
        },
        "dueDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "YYYY-MM-DD, or null for no due date."
        },
        "scheduledDay": {
          "anyOf": [
            {
              "$ref": "#/properties/dueDate/anyOf/0"
            },
            {
              "type": "null"
            }
          ],
          "description": "YYYY-MM-DD, or null to take it off the Clock (and clear its time)."
        },
        "scheduledTime": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ],
          "description": "HH:MM, or null for no particular time; a new time needs scheduledDay in the same change."
        },
        "projectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ],
          "description": "Id of an existing project, or null for the Inbox."
        },
        "goalId": {
          "anyOf": [
            {
              "$ref": "#/properties/projectId/anyOf/0"
            },
            {
              "type": "null"
            }
          ],
          "description": "Id of an existing goal, or null for none."
        },
        "repeat": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "unit": {
                  "type": "string",
                  "enum": [
                    "DAY",
                    "WEEK",
                    "MONTH",
                    "YEAR"
                  ],
                  "description": "DAY, WEEK, MONTH or YEAR."
                },
                "every": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 999,
                  "description": "Every this many units; left out = 1."
                },
                "from": {
                  "type": "string",
                  "enum": [
                    "SCHEDULE",
                    "COMPLETION"
                  ],
                  "description": "SCHEDULE (the default): fixed dates, e.g. every 1 November. COMPLETION: counted from the day it is done."
                },
                "leadDays": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 365
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Show it only this many days before it is due (e.g. 21 for a yearly task); left out or null = shown as soon as it is created."
                }
              },
              "required": [
                "unit"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "description": "Repeat from this occurrence on: { unit: DAY|WEEK|MONTH|YEAR, every?: number (default 1), from?: SCHEDULE (fixed dates, the default) or COMPLETION (counted from the day it is done), leadDays?: show it only this many days before it is due, e.g. 21 for yearly }; or null to stop repeating; left out = unchanged. Give the whole rule: a leadDays left out is removed. The task needs a due date or a scheduled day."
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true
    }
  },
