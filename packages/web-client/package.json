{
  "name": "@clock-compass/web-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-neutral browser client for the web app: the typed REST API client, token storage, week/zip/momentum helpers, display metadata and optimistic-edit bookkeeping. Source-only TypeScript; the app's Vite build compiles it.",
  "exports": {
    "./api": "./src/api.ts",
    "./token": "./src/token.ts",
    "./week": "./src/week.ts",
    "./zip": "./src/zip.ts",
    "./momentum": "./src/momentum.ts",
    "./meta": "./src/meta.ts",
    "./rollback": "./src/rollback.ts",
    "./agent": "./src/agent.ts",
    "./conversation": "./src/conversation.ts",
    "./random": "./src/random.ts",
    "./version": "./src/version.ts",
    "./time-zone": "./src/time-zone.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
