# Clock & Compass environment configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- Database ---------------------------------------------------------------
# SQLite to start. Swap the provider + URL for Postgres later without code changes.
# SQLite example:   file:./dev.db   (resolved relative to packages/core/prisma)
# Postgres example: postgresql://user:password@localhost:5432/clockcompass?schema=public
DATABASE_URL="file:./dev.db"

# --- Server -----------------------------------------------------------------
# Port the Fastify server listens on (also serves the built frontend in prod).
PORT=3000
HOST=0.0.0.0
# The server's time zone (an IANA name). "Today" and "this week" follow the
# device when the app asks (it sends its zone on every request); this zone is
# used where no device asks: MCP, API calls without X-Time-Zone, and the hour
# of push notifications. Unset = UTC. An unknown name stops the server at start.
# TZ="Europe/Brussels"
# Where the built frontend lives. Defaults to apps/web/dist; override only to
# serve a different build.
# WEB_DIST_PATH=/app/apps/web/dist

# --- Auth -------------------------------------------------------------------
# Bearer token for the REST API (single-user model). Generate a long random value.
API_AUTH_TOKEN="change-me-to-a-long-random-token"

# --- Web push (optional) -------------------------------------------------------
# Generate once with: pnpm --filter @clock-compass/server exec web-push generate-vapid-keys
# Leave blank to disable push notifications (the app works fine without them).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# --- AI ----------------------------------------------------------------------
# Not configured here: add providers, keys and models in the app, Settings → AI.
# AI_PROVIDER, ANTHROPIC_API_KEY, ANTHROPIC_MODEL, OPENAI_BASE_URL,
# OPENAI_API_KEY, OPENAI_MODEL and CODEX_MODEL are no longer read.
